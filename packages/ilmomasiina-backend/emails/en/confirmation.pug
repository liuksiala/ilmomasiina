extends ../layout.pug

block mainContent
  if admin && type == "signup"
    div.content-block
      p.bodyText #[strong An administrator has signed you up to this event.]
  if admin && type == "edit"
    div.content-block
      p.bodyText #[strong An administrator has edited your signup.]
  if paymentStatus == "pending"
    div.content-block
      p.bodyText
        strong Your signup is still pending payment!
        if event.payments == "online"
          |
          | You can complete the payment on the #[a(href=cancelLink) signup page].
  if queuePosition
    div.content-block
      p.bodyText #[strong You are in the queue in position #{queuePosition}.] If you get accepted from the queue, you will be notified by email.
  div.content-block
    p.bodyText #{type == "edit" ? "Your signup has been updated:" : "Successfully registered to the event:"}
    ul
      if name
        li #[strong Name:] #{name}
      li #[strong Email:] #{email}
      li #[strong Quota:] #{quota}
      li #[strong Event:] #{event.title}
      if date
        li #[strong Event time:] #{date}
      if event.location
        li #[strong Event location:] #{event.location}
      each val in answers
        li #[strong #{val.label}:] #{val.answer}
      li #[strong Link to the event:] #[a(href=eventLink) #{eventLink}]
  if event.verificationEmail
    div.content-block
      p.bodyText #{event.verificationEmail}
  div.content-block
    p.bodyText You can update or delete your registration via this link:
      br
      a(href=cancelLink) #{cancelLink}
