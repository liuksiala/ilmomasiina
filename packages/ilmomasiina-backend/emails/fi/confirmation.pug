extends ../layout.pug

block mainContent
  if admin && type == "signup"
    div.content-block
      p.bodyText #[strong Ylläpitäjä on ilmoittanut sinut tapahtumaan.]
  if admin && type == "edit"
    div.content-block
      p.bodyText #[strong Ylläpitäjä on muokannut ilmoittautumistasi.]
  if paymentStatus == "pending"
    div.content-block
      p.bodyText
        strong Ilmoittautumisesi odottaa vielä maksua!
        if event.payments == "online"
          |
          | Voit suorittaa maksun #[a(href=cancelLink) ilmoittautumissivulla].
  if queuePosition
    div.content-block
      p.bodyText #[strong Olet jonossa sijalla #{queuePosition}.] Jos saat paikan jonosta, sinulle lähetetään ilmoitus sähköpostitse.
  div.content-block
    p.bodyText #{type == "edit" ? "Ilmoittautumisesi tietoja on muokattu:" : "Ilmoittautuminen tapahtumaan onnistui:"}
    ul
      if name
        li #[strong Nimi:] #{name}
      li #[strong Sähköposti:] #{email}
      li #[strong Kiintiö:] #{quota}
      li #[strong Tapahtuma:] #{event.title}
      if date
        li #[strong Ajankohta:] #{date}
      if event.location
        li #[strong Paikka:] #{event.location}
      each val in answers
        li #[strong #{val.label}:] #{val.answer}
      li #[strong Linkki tapahtumaan:] #[a(href=eventLink) #{eventLink}]
  if event.verificationEmail
    div.content-block
      p.bodyText #{event.verificationEmail}
  div.content-block
    p.bodyText Voit muokata tietojasi tai poistaa ilmoittautumisesi tämän linkin takaa:
      br
      a(href=cancelLink) #{cancelLink}
