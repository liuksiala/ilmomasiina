# Kaplaaki-specific branding values. Copy these into your .env (see .env.example for everything else).
# Colors and fonts follow Kaplaaki Brand Book 2024.

BRANDING_HEADER_TITLE_TEXT="Kaplaakin ilmomasiina"
BRANDING_HEADER_TITLE_TEXT_SHORT=Ilmomasiina
BRANDING_FOOTER_GDPR_TEXT=Tietosuoja
BRANDING_FOOTER_GDPR_LINK=https://kaplaaki.fi/tietosuoja
BRANDING_FOOTER_HOME_TEXT=Kaplaaki.fi
BRANDING_FOOTER_HOME_LINK=https://kaplaaki.fi
BRANDING_LOGIN_PLACEHOLDER_EMAIL=hallitus@kaplaaki.fi
BRANDING_ICAL_CALENDAR_NAME="Kaplaakin tapahtumat"

MAIL_FROM="Kaplaaki Tapahtumat <no-reply@kaplaaki.fi>"
BRANDING_MAIL_HEADER_TEXT="Kaplaakin ilmomasiina"
# Served from packages/ilmomasiina-frontend/public. Must be a public absolute URL for email clients.
BRANDING_MAIL_LOGO_URL=https://ilmo.kaplaaki.fi/kaplaaki-logo.png
BRANDING_MAIL_COLOR="#001f3f"
BRANDING_MAIL_FOOTER_TEXT="© Kaplaaki ry – Tuotantotalouden kilta, Lappeenranta"
BRANDING_MAIL_FOOTER_LINK=https://kaplaaki.fi
